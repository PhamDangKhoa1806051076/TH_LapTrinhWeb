@using Microsoft.AspNetCore.Identity
@using PhamDangKhoa_W345_C2.Models
@using PhamDangKhoa_W345_C2.Extensions
@using Microsoft.AspNetCore.Http
@using System.Text.Json
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@{
    var cartCookie = HttpContextAccessor.HttpContext?.Request.Cookies["CartCookie"];
    var cart = new List<PhamDangKhoa_W345_C2.Models.CartItem>();
    if (!string.IsNullOrEmpty(cartCookie))
    {
        try { cart = JsonSerializer.Deserialize<List<PhamDangKhoa_W345_C2.Models.CartItem>>(cartCookie) ?? new List<PhamDangKhoa_W345_C2.Models.CartItem>(); }
        catch { }
    }
    int cartCount = cart.Sum(x => x.Quantity);
    decimal cartTotal = cart.Sum(x => x.Price * x.Quantity);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - An Gaming</title>
    
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PhamDangKhoa_W345_C2.styles.css" asp-append-version="true" />
    <style>
        .cart-container { position: relative; }
        .cart-btn { cursor: pointer; }
        .category-nav {
            position: sticky;
            top: 0;
            z-index: 1020;
            background-color: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        #scrollTopBtn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 999;
            display: none;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            padding: 0;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            align-items: center;
            justify-content: center;
        }
        #toast-container {
            z-index: 9999;
        }
    </style>
</head>
<body>
    <!-- Header Tầng 1 -->
    <header class="header-top">
        <div class="container">
            <div class="row align-items-center">
                <!-- Logo -->
                <div class="col-lg-3 col-6">
                    <a asp-controller="Home" asp-action="Index" class="logo-text">
                        <i class="fa-solid fa-owl" style="color: #e31e24; font-size: 30px;"></i>
                        AN<span>GAMING</span>
                    </a>
                </div>
                <!-- Search Bar -->
                <div class="col-lg-5 d-none d-lg-block">
                    <form asp-area="" asp-controller="Product" asp-action="List" method="get" class="search-bar">
                        <button type="submit" class="btn btn-link p-0 text-muted border-0"><i class="fa-solid fa-magnifying-glass"></i></button>
                        <input type="text" name="searchQuery" value="@ViewBag.SearchQuery" placeholder="Tìm sản phẩm theo tên..." class="form-control bg-transparent border-0 shadow-none text-dark" autocomplete="off">
                    </form>
                </div>
                <!-- Links & Cart -->
                <div class="col-lg-4 col-6 d-flex justify-content-end align-items-center gap-4">
                    <ul class="top-links d-none d-md-flex align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            var displayName = !string.IsNullOrEmpty(user?.FullName) ? user.FullName : user?.UserName;
                            <li class="d-flex align-items-center gap-2">
                                <a asp-controller="Account" asp-action="Profile" class="d-flex align-items-center gap-2 text-decoration-none">
                                    @if (!string.IsNullOrEmpty(user?.AvatarUrl))
                                    {
                                        <img src="@user.AvatarUrl" class="rounded-circle shadow-sm" style="width: 32px; height: 32px; object-fit: cover; border: 2px solid var(--primary-color);" title="Hồ sơ của @displayName" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-circle-user fs-4 text-primary" title="Hồ sơ của @displayName"></i>
                                    }
                                    <span class="fw-bold" style="color: var(--text-main); font-size: 13px; text-transform: none;">@displayName</span>
                                </a>
                            </li>
                            <li>
                                <form class="form-inline m-0 p-0" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link text-danger p-0 fw-bold" style="text-decoration: none; font-size: 13px;">Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li><a asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                            <li><a asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                        }
                        <li><a href="#">Giới thiệu</a></li>
                        <li><a href="#">Tin tức</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <!-- Header Tầng 2: Category Nav -->
    <nav class="navbar navbar-expand-md category-nav p-0 p-md-2">
        <div class="container">
            <button class="navbar-toggler w-100 my-2 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#categoryNav" aria-controls="categoryNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="d-flex align-items-center justify-content-center gap-2 text-dark" style="font-size: 16px;">
                    <i class="fa-solid fa-bars"></i> Danh mục sản phẩm
                </span>
            </button>
            
            <div class="collapse navbar-collapse" id="categoryNav">
                <!-- Hiển thị thanh tìm kiếm trên mobile (vì search-bar chính đã ẩn) -->
                <form asp-area="" asp-controller="Product" asp-action="List" method="get" class="search-bar d-lg-none mb-3 mt-2 w-100">
                    <button type="submit" class="btn btn-link p-0 text-muted border-0"><i class="fa-solid fa-magnifying-glass"></i></button>
                    <input type="text" name="searchQuery" value="@ViewBag.SearchQuery" placeholder="Tìm sản phẩm..." class="form-control border-0 bg-transparent ms-2 shadow-none" style="outline: none;">
                </form>
                
                <ul class="nav-menu flex-column flex-md-row w-100 pb-3 pb-md-0 align-items-start align-items-md-center gap-1">
                    <li class="w-100 py-1 py-md-0 border-bottom border-md-0"><a asp-area="" asp-controller="Product" asp-action="List" class="nav-link-custom @(ViewBag.CurrentCategory == null && Context.Request.Path.Value?.Contains("Product/List") == true && string.IsNullOrEmpty(ViewBag.SearchQuery) ? "active" : "")">Tất cả Sản phẩm</a></li>
                    <li class="w-100 py-1 py-md-0 border-bottom border-md-0"><a asp-area="" asp-controller="Product" asp-action="List" asp-route-categoryId="1" class="nav-link-custom @(ViewBag.CurrentCategory != null && (int)ViewBag.CurrentCategory == 1 ? "active" : "")">Laptop</a></li>
                    <li class="w-100 py-1 py-md-0 border-bottom border-md-0"><a asp-area="" asp-controller="Product" asp-action="List" asp-route-categoryId="2" class="nav-link-custom @(ViewBag.CurrentCategory != null && (int)ViewBag.CurrentCategory == 2 ? "active" : "")">Máy tính để bàn</a></li>
                    <li class="w-100 py-1 py-md-0 border-bottom border-md-0"><a asp-area="" asp-controller="Product" asp-action="List" asp-route-categoryId="3" class="nav-link-custom @(ViewBag.CurrentCategory != null && (int)ViewBag.CurrentCategory == 3 ? "active" : "")">Gaming Gear</a></li>
                    <li class="w-100 py-1 py-md-0 border-bottom border-md-0"><a asp-area="" asp-controller="Product" asp-action="List" asp-route-categoryId="4" class="nav-link-custom @(ViewBag.CurrentCategory != null && (int)ViewBag.CurrentCategory == 4 ? "active" : "")">Linh kiện PC</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="w-100 py-1 py-md-0 border-bottom border-md-0 ms-md-auto"><a asp-area="Admin" asp-controller="OrderManagement" asp-action="Index" class="nav-link-custom text-warning fw-bold"><i class="fa-solid fa-file-invoice-dollar me-1"></i>Duyệt đơn</a></li>
                        <li class="w-100 py-1 py-md-0 border-bottom border-md-0"><a asp-area="Admin" asp-controller="ProductManagement" asp-action="Index" class="nav-link-custom text-danger fw-bold"><i class="fa-solid fa-gear me-1"></i>Quản lý SP</a></li>
                    }
                </ul>
                <div class="cart-container ms-md-3 mt-3 mt-md-0">
                    <a href="#cartOffcanvas" data-bs-toggle="offcanvas" role="button" aria-controls="cartOffcanvas" class="cart-btn text-decoration-none">
                        <div class="cart-icon-wrapper">
                            <i class="fa-solid fa-bag-shopping fs-4"></i>
                            <span class="cart-badge" id="layoutCartCount">@cartCount</span>
                        </div>
                        <span class="cart-price d-none d-sm-inline" id="layoutCartTotal">@cartTotal.ToString("#,##0")đ</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Offcanvas Cart Drawer -->
    <div class="offcanvas offcanvas-end shadow" tabindex="-1" id="cartOffcanvas" aria-labelledby="cartOffcanvasLabel" style="width: 420px; border-left: none;">
        <div class="offcanvas-header pb-0 border-bottom-0 flex-column align-items-start px-4 pt-4">
            <div class="d-flex justify-content-between w-100 mb-2">
                <h4 class="offcanvas-title fw-bold d-flex align-items-center text-dark" id="cartOffcanvasLabel">
                    Giỏ hàng <span class="badge bg-primary rounded-circle ms-2 px-2" style="font-size: 0.9rem;" id="offcanvasCartCount">@cartCount</span>
                </h4>
                <button type="button" class="btn-close shadow-none fs-5" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <p class="text-dark mb-2 fs-7">Bạn được giao hàng miễn phí!</p>
            <div class="w-100 bg-primary rounded" style="height: 3px;"></div>
        </div>
        <div class="offcanvas-body p-0 d-flex flex-column" style="background-color: #fafafa;">
            <div class="cart-items-list flex-grow-1 overflow-auto p-4" id="layoutCartItems">
                @if (cart.Count == 0)
                {
                    <div class="text-center mt-5">
                        <i class="fa-solid fa-cart-shopping fs-1 text-muted mb-3"></i>
                        <p class="text-muted">Giỏ hàng trống</p>
                    </div>
                }
                else
                {
                    @foreach (var item in cart)
                    {
                        <div class="d-flex align-items-center mb-4 bg-transparent border-bottom pb-3">
                            <div class="bg-light rounded d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 80px; flex-shrink: 0;">
                                <img src="@item.ImageUrl" class="object-fit-contain w-100 h-100 p-1 mix-blend-multiply" />
                            </div>
                            <div class="flex-grow-1 pe-2">
                                <div class="text-dark fw-bold mb-1" style="font-size: 0.95rem; line-height: 1.3;">@item.ProductName</div>
                                <div class="text-secondary mb-1" style="font-size: 0.9rem;">@item.Price.ToString("#,##0")đ</div>
                                <div class="text-muted" style="font-size: 0.8rem;">Mặc định</div>
                            </div>
                            <div class="d-flex flex-column align-items-end justify-content-center ms-2" style="flex-shrink: 0;">
                                <div class="d-flex align-items-center mb-1 border rounded-1 p-1 bg-white">
                                    <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none p-0 px-1 update-qty-btn" data-id="@item.ProductId" data-qty="@(item.Quantity - 1)"><i class="fa-solid fa-minus" style="font-size: 0.7rem;"></i></button>
                                    <input type="number" class="form-control text-center update-qty-input shadow-none border-0 p-0 mx-1" data-id="@item.ProductId" value="@item.Quantity" min="0" style="width: 25px; font-size: 0.9rem; background: transparent;">
                                    <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none p-0 px-1 update-qty-btn" data-id="@item.ProductId" data-qty="@(item.Quantity + 1)"><i class="fa-solid fa-plus" style="font-size: 0.7rem;"></i></button>
                                </div>
                                <button type="button" class="btn btn-link text-muted text-decoration-underline p-0 m-0 fs-7 update-qty-btn" data-id="@item.ProductId" data-qty="0">Bỏ</button>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="bg-white border-top p-4 mt-auto">
                <div class="d-flex justify-content-between align-items-end mb-2">
                    <h5 class="fw-bold text-dark mb-0">Tổng</h5>
                    <h4 class="fw-bold text-dark mb-0" id="offcanvasCartTotal">@cartTotal.ToString("#,##0") VND</h4>
                </div>
                <p class="text-muted fs-7 mb-1" style="font-size: 0.85rem;">Đã bao gồm thuế; <a href="#" class="text-muted text-decoration-underline">Phí ship</a> sẽ được tính khi thanh toán</p>
                <a href="#" class="text-muted text-decoration-underline mb-4 d-inline-block" style="font-size: 0.85rem;">Thêm ghi chú</a>
                
                <div class="d-flex gap-3">
                    <a asp-controller="Cart" asp-action="Index" class="btn fw-bold flex-grow-1 border-0" style="background: #eef2f5; color: #1a4a5a; padding: 12px;">Xem giỏ hàng</a>
                    <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary fw-bold flex-grow-1 text-white border-0" style="background: #1d4ed8; padding: 12px;">
                        <i class="fa-solid fa-lock me-2 fs-7"></i>Thanh toán
                    </a>
                </div>
            </div>
        </div>
    </div>

    @RenderBody()

    <!-- Footer -->
    <footer class="footer-section">
        <div class="container">
            <div class="row">
                <!-- Cột 1: Thông tin công ty -->
                <div class="col-lg-3 col-md-6 mb-4 footer-column">
                    <h5>VỀ ANGAMING</h5>
                    <div class="contact-info">
                        <p><strong>Địa chỉ:</strong> 475A Điện Biên Phủ, phường Thạnh Mỹ Tây, Thành phố Hồ Chí Minh</p>
                        <p><strong>Hotline:</strong> 0969179244</p>
                        <p><strong>Email:</strong> thealexmark21@gmail.com</p>
                    </div>
                </div>
                <!-- Cột 2: Chính sách -->
                <div class="col-lg-3 col-md-6 mb-4 footer-column">
                    <h5>CHÍNH SÁCH</h5>
                    <ul>
                        <li><a href="#">Điều kiện giao dịch chung</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Chính sách bảo hành</a></li>
                        <li><a href="#">Chính sách đổi trả hàng</a></li>
                        <li><a href="#">Phương thức thanh toán</a></li>
                    </ul>
                </div>
                <!-- Cột 3: Liên kết -->
                <div class="col-lg-3 col-md-6 mb-4 footer-column">
                    <h5>KÊNH LIÊN KẾT</h5>
                    <ul>
                        <li><a href="#">Facebook</a></li>
                        <li><a href="#">Shopee</a></li>
                        <li><a href="#">Tiki</a></li>
                        <li><a href="#">Lazada</a></li>
                    </ul>
                </div>
                <!-- Cột 4: Fanpage -->
                <div class="col-lg-3 col-md-6 mb-4 footer-column">
                    <h5>FANPAGE</h5>
                    <div class="facebook-widget">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div style="width: 50px; height: 50px; background: #eee; display: flex; align-items: center; justify-content: center; border-radius: 4px;">
                                <i class="fa-solid fa-owl" style="color: #e31e24;"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 text-dark">An Gaming</h6>
                                <small class="text-muted">10.801 người theo dõi</small>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-light text-dark border w-100 mb-1"><i class="fa-brands fa-facebook"></i> Theo dõi Trang</button>
                    </div>
                </div>
            </div>
            <hr class="my-4" style="border-color: var(--border-color)">
            <div class="text-center text-muted">
                <small>&copy; 2026 AN Gaming. Thiết kế bởi Trương Thanh Hoài An.</small>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Toast Container -->
    <div id="toast-container" class="position-fixed bottom-0 end-0 p-3">
        <div id="cartToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fw-bold">
                    <i class="fa-solid fa-circle-check me-2"></i><span id="toastMsg">Thêm thành công!</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Scroll to Top Button -->
    <button type="button" class="btn btn-primary d-flex" id="scrollTopBtn" title="Lên đầu trang">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script>
        // Scroll to Top Logic
        const scrollTopBtn = document.getElementById("scrollTopBtn");
        window.addEventListener("scroll", function() {
            if (document.body.scrollTop > 200 || document.documentElement.scrollTop > 200) {
                scrollTopBtn.style.display = "flex";
            } else {
                scrollTopBtn.style.display = "none";
            }
        });
        scrollTopBtn.addEventListener("click", function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        function updateCartDropdown(cartItems) {
            const container = document.getElementById('layoutCartItems');
            container.innerHTML = '';
            if (!cartItems || cartItems.length === 0) {
                container.innerHTML = `
                    <div class="text-center mt-5">
                        <i class="fa-solid fa-cart-shopping fs-1 text-muted mb-3"></i>
                        <p class="text-muted">Giỏ hàng trống</p>
                    </div>
                `;
                return;
            }
            
            cartItems.forEach(item => {
                const formattedPrice = new Intl.NumberFormat('vi-VN').format(item.price) + 'đ';
                const row = document.createElement('div');
                row.className = 'd-flex align-items-center mb-4 bg-transparent border-bottom pb-3';
                row.innerHTML = `
                    <div class="bg-light rounded d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 80px; flex-shrink: 0;">
                        <img src="${item.imageUrl}" class="object-fit-contain w-100 h-100 p-1 mix-blend-multiply" />
                    </div>
                    <div class="flex-grow-1 pe-2">
                        <div class="text-dark fw-bold mb-1" style="font-size: 0.95rem; line-height: 1.3;">${item.productName}</div>
                        <div class="text-secondary mb-1" style="font-size: 0.9rem;">${formattedPrice}</div>
                        <div class="text-muted" style="font-size: 0.8rem;">Mặc định</div>
                    </div>
                    <div class="d-flex flex-column align-items-end justify-content-center ms-2" style="flex-shrink: 0;">
                        <div class="d-flex align-items-center mb-1 border rounded-1 p-1 bg-white">
                            <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none p-0 px-1 update-qty-btn" data-id="${item.productId}" data-qty="${item.quantity - 1}"><i class="fa-solid fa-minus" style="font-size: 0.7rem;"></i></button>
                            <input type="number" class="form-control text-center update-qty-input shadow-none border-0 p-0 mx-1" data-id="${item.productId}" value="${item.quantity}" min="0" style="width: 25px; font-size: 0.9rem; background: transparent;">
                            <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none p-0 px-1 update-qty-btn" data-id="${item.productId}" data-qty="${item.quantity + 1}"><i class="fa-solid fa-plus" style="font-size: 0.7rem;"></i></button>
                        </div>
                        <button type="button" class="btn btn-link text-muted text-decoration-underline p-0 m-0 fs-7 update-qty-btn" data-id="${item.productId}" data-qty="0">Bỏ</button>
                    </div>
                `;
                container.appendChild(row);
            });
        }

        function submitCartQuantityUpdate(productId, quantity, btn) {
            if (btn) btn.disabled = true;

            fetch('/Cart/UpdateQuantityApi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    productId: productId,
                    quantity: quantity
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('layoutCartCount').innerText = data.cartCount;
                    document.getElementById('offcanvasCartCount').innerText = data.cartCount;
                    
                    const formattedTotal = new Intl.NumberFormat('vi-VN').format(data.cartTotal) + 'đ';
                    const formattedTotalVnd = new Intl.NumberFormat('vi-VN').format(data.cartTotal) + ' VND';
                    
                    document.getElementById('layoutCartTotal').innerText = formattedTotal;
                    document.getElementById('offcanvasCartTotal').innerText = formattedTotalVnd;
                    
                    updateCartDropdown(data.cartItems);
                } else {
                    if (btn) btn.disabled = false;
                    const toastEl = document.getElementById('cartToast');
                    document.getElementById('toastMsg').innerText = data.message || 'Lỗi';
                    toastEl.classList.remove('bg-success');
                    toastEl.classList.add('bg-danger');
                    new bootstrap.Toast(toastEl).show();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                if (btn) btn.disabled = false;
            });
        }

        document.getElementById('layoutCartItems').addEventListener('click', function(e) {
            if (e.target.classList.contains('update-qty-btn')) {
                const btn = e.target;
                const productId = btn.getAttribute('data-id');
                const quantity = btn.getAttribute('data-qty');
                submitCartQuantityUpdate(productId, quantity, btn);
            }
        });

        document.getElementById('layoutCartItems').addEventListener('change', function(e) {
            if (e.target.classList.contains('update-qty-input')) {
                const input = e.target;
                const productId = input.getAttribute('data-id');
                const quantity = input.value;
                submitCartQuantityUpdate(productId, quantity, null);
            }
        });

        // AJAX Add to Cart
        document.addEventListener('DOMContentLoaded', function() {
            const addToCartForms = document.querySelectorAll('form[action$="/AddToCart"]');
            
            addToCartForms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    const formData = new FormData(this);
                    
                    fetch('/Cart/AddToCartApi', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Update badge and total
                            document.getElementById('layoutCartCount').innerText = data.cartCount;
                            document.getElementById('offcanvasCartCount').innerText = data.cartCount;
                            
                            const formattedTotal = new Intl.NumberFormat('vi-VN').format(data.cartTotal) + 'đ';
                            const formattedTotalVnd = new Intl.NumberFormat('vi-VN').format(data.cartTotal) + ' VND';
                            
                            document.getElementById('layoutCartTotal').innerText = formattedTotal;
                            document.getElementById('offcanvasCartTotal').innerText = formattedTotalVnd;
                            
                            // Update dropdown
                            updateCartDropdown(data.cartItems);
                            
                            // Show offcanvas instead of toast
                            const cartOffcanvasEl = document.getElementById('cartOffcanvas');
                            const bsOffcanvas = bootstrap.Offcanvas.getInstance(cartOffcanvasEl) || new bootstrap.Offcanvas(cartOffcanvasEl);
                            bsOffcanvas.show();
                        } else {
                            // Show error toast
                            const toastEl = document.getElementById('cartToast');
                            const toastBody = document.getElementById('toastMsg');
                            toastBody.innerText = data.message;
                            toastEl.classList.remove('bg-success');
                            toastEl.classList.add('bg-danger');
                            const toast = new bootstrap.Toast(toastEl);
                            toast.show();
                        }
                    })
                    .catch(error => {
                        console.error('Error adding to cart:', error);
                    });
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
