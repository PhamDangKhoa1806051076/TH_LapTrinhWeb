@model List<PhamDangKhoa_W345_C2.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<style>
    body {
        background-color: #f8f9fa;
    }
    .cart-page-header {
        position: relative;
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
        border-bottom: 2px solid #e9ecef;
    }
    .cart-item-card {
        background: #fff;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #f1f3f5;
    }
    .cart-item-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
    }
    .cart-item-img {
        width: 100px;
        height: 100px;
        object-fit: contain;
        background: #f8f9fa;
        border-radius: 12px;
        padding: 10px;
    }
    .cart-item-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #2b2b2b;
        text-decoration: none;
        transition: color 0.2s;
    }
    .cart-item-title:hover {
        color: #e31e24;
    }
    .cart-item-price {
        font-size: 1.1rem;
        font-weight: 700;
        color: #e31e24;
    }
    .qty-input-group {
        width: 120px;
        background: #f8f9fa;
        border-radius: 50px;
        padding: 4px;
        border: 1px solid #e9ecef;
    }
    .qty-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: #fff;
        color: #495057;
        font-weight: bold;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        transition: all 0.2s;
    }
    .qty-btn:hover:not(:disabled) {
        background: #e9ecef;
        color: #000;
    }
    .qty-input {
        width: 40px;
        border: none;
        background: transparent;
        text-align: center;
        font-weight: bold;
        color: #495057;
    }
    .qty-input:focus {
        outline: none;
    }
    .btn-remove {
        color: #adb5bd;
        background: transparent;
        border: none;
        padding: 8px;
        border-radius: 8px;
        transition: all 0.2s;
    }
    .btn-remove:hover {
        color: #dc3545;
        background: #fff5f5;
    }
    .summary-card {
        background: #fff;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid #f1f3f5;
        position: sticky;
        top: 100px;
    }
    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1rem;
        font-size: 1.05rem;
        color: #495057;
    }
    .summary-total {
        font-size: 1.5rem;
        font-weight: 800;
        color: #e31e24;
        border-top: 2px dashed #e9ecef;
        padding-top: 1.5rem;
        margin-top: 1rem;
    }
    .btn-checkout {
        background: linear-gradient(135deg, #e31e24, #ff4d4d);
        border: none;
        border-radius: 50px;
        padding: 1rem;
        font-size: 1.1rem;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(227, 30, 36, 0.3);
        transition: all 0.3s;
    }
    .btn-checkout:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(227, 30, 36, 0.4);
    }
    .empty-cart-state {
        text-align: center;
        padding: 5rem 2rem;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
    .empty-cart-icon {
        width: 120px;
        height: 120px;
        background: #f8f9fa;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        color: #dee2e6;
        font-size: 3rem;
    }
</style>

<div class="container py-5" style="min-height: 75vh;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb fs-6">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-house me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Giỏ hàng của bạn</li>
        </ol>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4"><i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4"><i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="empty-cart-state">
            <div class="empty-cart-icon">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <h3 class="fw-bold text-dark mb-3">Giỏ hàng của bạn đang trống!</h3>
            <p class="text-muted mb-4 fs-5">Cảm giác trống vắng quá. Hãy thêm vài món đồ công nghệ yêu thích nhé.</p>
            <a asp-controller="Product" asp-action="List" class="btn btn-dark btn-lg rounded-pill px-5 fw-bold shadow-sm">Khám phá ngay</a>
        </div>
    }
    else
    {
        int totalItems = Model.Sum(x => x.Quantity);
        
        <div class="cart-page-header d-flex justify-content-between align-items-end">
            <div>
                <h2 class="fw-bold mb-1">Giỏ hàng</h2>
                <p class="text-muted mb-0">Bạn đang có <strong class="text-dark">@totalItems</strong> sản phẩm trong giỏ</p>
            </div>
            <a asp-controller="Product" asp-action="List" class="text-decoration-none fw-bold"><i class="fa-solid fa-arrow-left me-2"></i>Tiếp tục mua sắm</a>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <!-- Cart Items List -->
                @foreach (var item in Model)
                {
                    <div class="cart-item-card d-flex flex-column flex-md-row align-items-md-center gap-3 gap-md-4">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="flex-shrink-0">
                            <img src="@item.ImageUrl" alt="@item.ProductName" class="cart-item-img">
                        </a>
                        
                        <div class="flex-grow-1">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="cart-item-title d-block mb-1">@item.ProductName</a>
                            <div class="cart-item-price mb-3 mb-md-0">@item.Price.ToString("#,##0") ₫</div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between gap-4 mt-2 mt-md-0">
                            <!-- Quantity Form -->
                            <form asp-action="UpdateQuantity" method="post" class="qty-input-group d-flex align-items-center m-0">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="button" class="qty-btn" onclick="this.nextElementSibling.stepDown(); this.form.submit();" @(item.Quantity <= 1 ? "disabled" : "")><i class="fa-solid fa-minus fs-7"></i></button>
                                <input type="number" name="quantity" value="@item.Quantity" min="0" class="qty-input" onchange="this.form.submit()" />
                                <button type="button" class="qty-btn" onclick="this.previousElementSibling.stepUp(); this.form.submit();"><i class="fa-solid fa-plus fs-7"></i></button>
                            </form>

                            <!-- Item Total -->
                            <div class="fw-bold text-dark text-end d-none d-sm-block" style="width: 120px;">
                                @((item.Price * item.Quantity).ToString("#,##0")) ₫
                            </div>

                            <!-- Remove Button -->
                            <a asp-action="RemoveFromCart" asp-route-productId="@item.ProductId" class="btn-remove" title="Xóa khỏi giỏ hàng">
                                <i class="fa-solid fa-trash-can fs-5"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <!-- Order Summary -->
                <div class="summary-card">
                    <h4 class="fw-bold mb-4">Tóm tắt đơn hàng</h4>
                    
                    <div class="summary-row">
                        <span>Tổng tạm tính</span>
                        <span class="fw-bold text-dark">@Model.Sum(x => x.Price * x.Quantity).ToString("#,##0") ₫</span>
                    </div>
                    
                    <div class="summary-row">
                        <span>Phí giao hàng</span>
                        <span class="fw-bold text-success">Miễn phí</span>
                    </div>
                    
                    <div class="summary-row">
                        <span>Thuế (VAT)</span>
                        <span class="fw-bold text-dark">Đã bao gồm</span>
                    </div>

                    <div class="summary-row summary-total">
                        <span>Thành tiền</span>
                        <span>@Model.Sum(x => x.Price * x.Quantity).ToString("#,##0") ₫</span>
                    </div>

                    <p class="text-muted fs-7 text-center mt-3 mb-4"><i class="fa-solid fa-shield-halved me-1 text-success"></i> Thông tin thanh toán được bảo mật an toàn</p>

                    <a asp-action="Checkout" class="btn btn-primary btn-checkout w-100 d-flex align-items-center justify-content-center gap-2">
                        Tiến hành thanh toán <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
