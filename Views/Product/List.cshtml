@model IEnumerable<WebBanHang2.Models.Product>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<!-- Main Content: Products -->
<main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Tất cả sản phẩm</h3>
    </div>
    
    <!-- Category Filter -->
    <div class="mb-4">
        <div class="nav nav-pills gap-2">
            <a asp-action="List" class="nav-link @(ViewBag.CurrentCategory == null ? "active bg-danger" : "text-dark bg-light") rounded-pill px-4">Tất cả</a>
            @foreach (var category in ViewBag.Categories)
            {
                <a asp-action="List" asp-route-categoryId="@category.Id" class="nav-link @(ViewBag.CurrentCategory == category.Id ? "active bg-danger" : "text-dark bg-light") rounded-pill px-4">@category.Name</a>
            }
        </div>
    </div>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="product-card">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" alt="@product.Name" style="object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px; width: 100%;">
                            <i class="fa-solid fa-image fa-3x"></i>
                        </div>
                    }
                    <div class="card-content">
                        <h5>@product.Name</h5>
                        <p class="price">@product.Price.ToString("#,##0")đ</p>
                        <div class="d-flex gap-2">
                            <a asp-controller="Product" asp-action="Display" asp-route-id="@product.Id" class="btn btn-outline-danger btn-sm flex-grow-1">Chi tiết</a>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-grow-1 m-0">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-danger btn-sm w-100"><i class="fa-solid fa-cart-plus"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if(!Model.Any()) {
            <div class="col-12 text-center text-muted py-5">
                <i class="fa-solid fa-box-open fs-1 mb-3 text-light"></i>
                <p>Chưa có sản phẩm nào.</p>
            </div>
        }
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="List" asp-route-page="@i" asp-route-categoryId="@ViewBag.CurrentCategory">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</main>
