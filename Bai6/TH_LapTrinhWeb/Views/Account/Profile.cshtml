@model PhamDangKhoa_W345_C2.Models.ApplicationUser
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<main class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header Background -->
                <div class="bg-primary p-4 text-white text-center position-relative" style="background: linear-gradient(135deg, var(--primary-color), #4dabf7) !important;">
                    <h3 class="fw-bold m-0 text-uppercase letter-spacing-1">Hồ sơ cá nhân</h3>
                    <p class="mb-0 text-white-50 mt-1">Quản lý thông tin tài khoản của bạn</p>
                </div>
                
                <div class="card-body p-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <!-- Avatar Section -->
                            <div class="col-md-4 text-center mb-4 mb-md-0 border-end">
                                <div class="position-relative d-inline-block mb-3">
                                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                                    {
                                        <img src="@Model.AvatarUrl" class="rounded-circle shadow" style="width: 160px; height: 160px; object-fit: cover; border: 4px solid #fff; outline: 2px solid var(--primary-color);" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-circle-user text-muted shadow rounded-circle bg-white" style="font-size: 160px; outline: 2px solid var(--primary-color);"></i>
                                    }
                                    <label for="avatarUpload" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle p-2 shadow cursor-pointer" style="cursor: pointer; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; transform: translate(-10px, -10px); transition: 0.3s;">
                                        <i class="fa-solid fa-camera"></i>
                                    </label>
                                    <input type="file" id="avatarUpload" name="avatarFile" class="d-none" accept="image/*" onchange="previewAvatar(this);" />
                                </div>
                                <h5 class="fw-bold text-main mt-2">@(!string.IsNullOrEmpty(Model.FullName) ? Model.FullName : Model.UserName)</h5>
                                <span class="badge bg-secondary px-3 py-2 rounded-pill">Quản trị viên</span>
                                <div class="mt-3 text-start">
                                    <small class="text-muted d-block text-center"><i class="fa-solid fa-circle-info me-1"></i> Bấm vào biểu tượng máy ảnh để chọn ảnh đại diện mới.</small>
                                </div>
                            </div>

                            <!-- Info Section -->
                            <div class="col-md-8 ps-md-4">
                                <h5 class="fw-bold mb-4 border-bottom pb-2 text-primary">Thông tin cơ bản</h5>
                                
                                <div class="mb-3">
                                    <label class="form-label fw-medium text-secondary">Tên hiển thị (Tên Admin)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                                        <input type="text" name="fullName" class="form-control form-control-lg bg-light border-start-0" value="@Model.FullName" placeholder="Nhập tên hiển thị của bạn..." />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-medium text-secondary">Email (Tên đăng nhập)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                                        <input type="email" class="form-control form-control-lg bg-light border-start-0 text-muted" value="@Model.Email" readonly disabled />
                                    </div>
                                    <div class="form-text mt-1"><i class="fa-solid fa-lock text-warning"></i> Email không thể thay đổi.</div>
                                </div>

                                <div class="d-grid mt-5">
                                    <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold text-uppercase shadow-sm" style="letter-spacing: 1px;">
                                        <i class="fa-solid fa-floppy-disk me-2"></i> Lưu thay đổi
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        function previewAvatar(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = input.closest('.position-relative').querySelector('img');
                    var icon = input.closest('.position-relative').querySelector('.fa-circle-user');
                    if(img) {
                        img.src = e.target.result;
                    } else if(icon) {
                        var newImg = document.createElement('img');
                        newImg.src = e.target.result;
                        newImg.className = "rounded-circle shadow";
                        newImg.style = "width: 160px; height: 160px; object-fit: cover; border: 4px solid #fff; outline: 2px solid var(--primary-color);";
                        icon.replaceWith(newImg);
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
