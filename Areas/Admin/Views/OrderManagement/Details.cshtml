@model WebBanHang2.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="container my-5" style="min-height: 70vh;">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3"><i class="fa-solid fa-arrow-left"></i></a>
        <h3 class="fw-bold mb-0">Chi tiết đơn hàng #@Model.Id</h3>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row">
        <!-- Thông tin đơn hàng -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0"><i class="fa-solid fa-box-open me-2 text-primary"></i>Danh sách sản phẩm</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th>SL</th>
                                    <th class="pe-4 text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var detail in Model.OrderDetails)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@detail.Product.ImageUrl" width="40" height="40" class="rounded border object-fit-contain p-1" />
                                                <span class="fw-bold text-dark">@detail.Product.Name</span>
                                            </div>
                                        </td>
                                        <td>@detail.Price.ToString("#,##0") ₫</td>
                                        <td>@detail.Quantity</td>
                                        <td class="pe-4 text-end fw-bold text-danger">@((detail.Price * detail.Quantity).ToString("#,##0")) ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-5">Tổng tiền:</span>
                    <span class="fw-bold fs-4 text-danger">@Model.TotalAmount.ToString("#,##0") ₫</span>
                </div>
            </div>
        </div>

        <!-- Trạng thái và Khách hàng -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Trạng thái xử lý</h5>
                    <div class="d-flex align-items-center mb-4">
                        <span class="me-3">Hiện tại:</span>
                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6">Chờ duyệt</span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="badge bg-primary px-3 py-2 fs-6">Đã duyệt</span>
                        }
                        else if (Model.Status == "Completed")
                        {
                            <span class="badge bg-success px-3 py-2 fs-6">Hoàn thành</span>
                        }
                        else
                        {
                            <span class="badge bg-danger px-3 py-2 fs-6">Đã hủy</span>
                        }
                    </div>

                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="input-group">
                            <select name="status" class="form-select bg-light border-0">
                                <option value="Pending" selected="@(Model.Status == "Pending")">Chờ duyệt</option>
                                <option value="Approved" selected="@(Model.Status == "Approved")">Duyệt & Đang giao</option>
                                <option value="Completed" selected="@(Model.Status == "Completed")">Hoàn thành</option>
                                <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Hủy đơn</option>
                            </select>
                            <button type="submit" class="btn btn-primary fw-bold">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Thông tin khách hàng</h5>
                    <p class="mb-2"><i class="fa-solid fa-user text-muted me-2"></i> <span class="fw-bold">@Model.User.FullName</span></p>
                    <p class="mb-2"><i class="fa-solid fa-phone text-muted me-2"></i> @Model.PhoneNumber</p>
                    <p class="mb-2"><i class="fa-solid fa-envelope text-muted me-2"></i> @Model.User.Email</p>
                    <p class="mb-0"><i class="fa-solid fa-location-dot text-muted me-2"></i> @Model.ShippingAddress</p>
                </div>
            </div>
        </div>
    </div>
</main>
