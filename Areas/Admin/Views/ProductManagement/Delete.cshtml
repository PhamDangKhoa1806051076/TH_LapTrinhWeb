@model WebBanHang2.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}
<h2>Are you sure you want to delete this?</h2>
<!-- Hiển thị thông tin sản phẩm cần xóa -->
<div>
    <h4>Name: @Model.Name</h4>
    <h4>Price: @Model.Price</h4>
    <h4>Description: @Model.Description</h4>
</div>
<!-- Form submit để gọi action DeleteConfirmed trong controller -->
<form asp-action="DeleteConfirmed" method="post">
    <!-- Gửi kèm Id của sản phẩm ẩn để server biết xóa sản phẩm nào -->
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" /> |
    <!-- Nút Hủy quay về trang danh sách (Index) -->
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
