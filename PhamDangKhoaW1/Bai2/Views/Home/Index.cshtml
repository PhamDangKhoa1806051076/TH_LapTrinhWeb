@model IEnumerable<Bai2.Models.Product>

@{
    ViewData["Title"] = "Trang Chủ";
}

<!-- Tiêu đề trang chủ -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="section-title mb-1">Thiết Bị Công Nghệ</h2>
        <p class="text-muted small mb-0">Hệ thống quản lý và phân phối sản phẩm chính hãng</p>
    </div>
    <a asp-controller="Product" asp-action="Add" class="btn btn-modern-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Thêm Sản Phẩm
    </a>
</div>

@if (!Model.Any())
{
    <!-- Trạng thái rỗng -->
    <div class="text-center py-5">
        <i class="bi bi-box-seam text-muted" style="font-size: 4rem;"></i>
        <h5 class="mt-3 text-muted fw-semibold">Chưa có sản phẩm nào</h5>
        <p class="text-muted small">Hãy thêm sản phẩm đầu tiên vào hệ thống.</p>
        <a asp-controller="Product" asp-action="Add" class="btn btn-modern-primary mt-2">
            <i class="bi bi-plus-lg me-1"></i>Thêm Sản Phẩm
        </a>
    </div>
}
else
{
    <!-- Lưới hiển thị sản phẩm dạng card - theo mẫu Bài 1 -->
    <!-- Hiển thị 2 cột trên điện thoại, 3 cột trên tablet, 4 cột trên PC -->
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-2">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 product-card">
                    <!-- Ảnh sản phẩm -->
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name">
                    }
                    else
                    {
                        <!-- Icon fallback theo danh mục -->
                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 160px;">
                            @if (product.CategoryId == 1)
                            {
                                <i class="bi bi-laptop text-primary" style="font-size: 3.5rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-phone text-primary" style="font-size: 3.5rem;"></i>
                            }
                        </div>
                    }

                    <div class="card-body p-2">
                        <h5 class="card-title text-truncate" title="@product.Name">@product.Name</h5>
                        <p class="card-text">@product.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h6 mb-0 text-primary fw-bold">$@product.Price.ToString("#,##0")</span>
                            <!-- Badge danh mục -->
                            <span class="badge bg-secondary rounded-pill" style="font-size: 0.7rem;">
                                @(product.CategoryId == 1 ? "Laptop" : "Điện thoại")
                            </span>
                        </div>
                    </div>

                    <!-- Footer card: các nút hành động -->
                    <div class="card-footer d-flex justify-content-between align-items-center bg-light p-2">
                        <a asp-controller="Product" asp-action="Display" asp-route-id="@product.Id"
                           class="btn btn-primary btn-sm">
                            <i class="bi bi-eye me-1"></i>Xem
                        </a>
                        <div class="d-flex gap-1">
                            <a asp-controller="Product" asp-action="Update" asp-route-id="@product.Id"
                               class="btn btn-outline-warning btn-sm px-2" title="Chỉnh sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id"
                               class="btn btn-outline-danger btn-sm px-2" title="Xóa">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
