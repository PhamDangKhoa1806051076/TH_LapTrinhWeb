@model IEnumerable<Bai2.Models.Product>

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<!-- Tiêu đề + nút thêm -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="section-title mb-1">Quản Lý Sản Phẩm</h2>
        <p class="text-muted small mb-0">Danh sách toàn bộ sản phẩm trong hệ thống</p>
    </div>
    <a asp-action="Add" class="btn btn-modern-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Thêm Sản Phẩm
    </a>
</div>

<!-- Bảng DataTable -->
<div class="modern-form-card p-3">
    <div class="table-responsive">
        <table id="productDataTable" class="table table-hover align-middle mb-0" style="width:100%">
            <thead class="table-dark">
                <tr>
                    <th>Mã SP</th>
                    <th>Hình Ảnh</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Giá (USD)</th>
                    <th>Mô Tả</th>
                    <th class="text-center" style="min-width:180px;">Chức Năng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <!-- Mã sản phẩm -->
                        <td>
                            <span class="badge bg-secondary">#@product.Id</span>
                        </td>

                        <!-- Hình ảnh -->
                        <td>
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     alt="@product.Name"
                                     class="rounded border"
                                     style="width:60px; height:60px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-light rounded border"
                                     style="width:60px; height:60px;">
                                    @if (product.CategoryId == 1)
                                    {
                                        <i class="bi bi-laptop text-primary fs-4"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-phone text-primary fs-4"></i>
                                    }
                                </div>
                            }
                        </td>

                        <!-- Tên sản phẩm -->
                        <td>
                            <div class="fw-semibold text-dark">@product.Name</div>
                            <span class="badge bg-primary-subtle text-primary rounded-pill" style="font-size:0.7rem;">
                                @(product.CategoryId == 1 ? "Laptop" : "Điện thoại")
                            </span>
                        </td>

                        <!-- Giá -->
                        <td>
                            <span class="product-price-badge fw-bold">$@product.Price.ToString("#,##0")</span>
                        </td>

                        <!-- Mô tả -->
                        <td>
                            <span class="text-muted small d-inline-block"
                                  style="max-width:220px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                                  title="@product.Description">
                                @product.Description
                            </span>
                        </td>

                        <!-- Chức năng: Xem / Sửa / Xóa -->
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-1 flex-wrap">
                                <!-- Xem chi tiết -->
                                <a asp-action="Display" asp-route-id="@product.Id"
                                   class="btn btn-sm btn-outline-primary rounded-3 px-2"
                                   title="Xem chi tiết">
                                    <i class="bi bi-eye me-1"></i>Xem
                                </a>
                                <!-- Chỉnh sửa -->
                                <a asp-action="Update" asp-route-id="@product.Id"
                                   class="btn btn-sm btn-outline-warning rounded-3 px-2"
                                   title="Chỉnh sửa sản phẩm">
                                    <i class="bi bi-pencil me-1"></i>Sửa
                                </a>
                                <!-- Xóa -->
                                <a asp-action="Delete" asp-route-id="@product.Id"
                                   class="btn btn-sm btn-outline-danger rounded-3 px-2"
                                   title="Xóa sản phẩm">
                                    <i class="bi bi-trash3 me-1"></i>Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Khởi tạo DataTable với đầy đủ tính năng: Tìm kiếm, Phân trang, Sắp xếp
        $(document).ready(function () {
            $('#productDataTable').DataTable({
                // Ngôn ngữ Tiếng Việt
                language: {
                    search:           "Tìm kiếm:",
                    searchPlaceholder: "Nhập từ khóa...",
                    lengthMenu:       "Hiển thị _MENU_ sản phẩm",
                    info:             "Đang hiển thị _START_ đến _END_ trong tổng số _TOTAL_ sản phẩm",
                    infoEmpty:        "Không có sản phẩm nào",
                    infoFiltered:     "(lọc từ _MAX_ sản phẩm)",
                    zeroRecords:      "Không tìm thấy sản phẩm phù hợp",
                    emptyTable:       "Chưa có sản phẩm nào trong hệ thống",
                    paginate: {
                        first:    "Đầu",
                        last:     "Cuối",
                        next:     "Tiếp &raquo;",
                        previous: "&laquo; Trước"
                    }
                },
                // Số hàng mỗi trang
                pageLength: 5,
                lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "Tất cả"]],
                // Thứ tự sắp xếp mặc định theo cột Mã SP tăng dần
                order: [[0, 'asc']],
                // Tắt sắp xếp ở cột Hình Ảnh và Chức Năng (cột 1 và 5)
                columnDefs: [
                    { orderable: false, targets: [1, 5] },
                    { searchable: false, targets: [1, 5] }
                ],
                // Responsive layout
                responsive: true
            });
        });
    </script>
}
